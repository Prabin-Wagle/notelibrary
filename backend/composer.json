{
  "name": "note-library/admin-api",
  "description": "Note Library V2 admin REST API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "monolog/monolog": "^3.9",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.15",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php bin/migrate.php",
    "check": "php -l public/index.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
