APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8081
API_BASE_PATH=
APP_TIMEZONE=UTC
APP_KEY=replace-with-a-random-64-character-secret

FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=note_library_v2
DB_USERNAME=note_library
DB_PASSWORD=
DB_CHARSET=utf8mb4
MEDIA_STORAGE_PATH=path/to/shared/resource-uploads

ADMIN_SESSION_COOKIE=nl_admin_session
ADMIN_SESSION_SECURE=false
ADMIN_SESSION_SAMESITE=Lax
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=12

LOG_LEVEL=debug
