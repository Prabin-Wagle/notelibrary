APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
API_BASE_PATH=
APP_TIMEZONE=UTC
APP_KEY=replace-with-a-random-64-character-secret

FRONTEND_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=note_library_v2
