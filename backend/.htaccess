Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:src|vendor|database|bin|storage)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\.example)?|config(?:\.example|\.local)?\.php|db\.php|check-db\.php|composer\.(?:json|lock)|README\.md|ADMIN_ARCHITECTURE\.md)$ - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>

<FilesMatch "^(?:\.env|config\.local\.php|db\.php)$">
    Require all denied
</FilesMatch>
