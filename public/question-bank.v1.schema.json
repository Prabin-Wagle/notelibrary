{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notelibraryapp.com/schemas/question-bank.v1.schema.json",
  "title": "Note Library question bank import",
  "description": "Version 1 JSON envelope for importing and exporting entrance-exam questions.",
  "type": "object",
  "required": ["schemaVersion", "examCode", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "examCode": { "enum": ["IOE", "CEE"] },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "sourceIndex", "sourceFile", "sourceSubject", "chapter", "questionText", "options", "correctOption", "marks"],
        "properties": {
          "sourceId": { "type": ["string", "integer"] },
          "sourceIndex": { "type": "integer", "minimum": 1 },
          "sourceFile": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sourceSubject": { "type": "string", "minLength": 1, "maxLength": 140 },
          "chapter": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sourceChapterId": { "type": ["string", "null"], "maxLength": 200 },
          "questionText": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          },
          "correctOption": { "type": "integer", "minimum": 0 },
          "marks": { "type": "number", "minimum": 0 },
          "explanation": { "type": ["string", "null"] },
          "imageLink": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
