<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Keep same-origin API requests out of the SPA fallback.
  RewriteRule ^api(/|$) - [L,NC]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
